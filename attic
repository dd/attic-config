#!/usr/bin/env python3
"""Manage independent NAS tweaks from a persistent attic-config checkout."""

import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).absolute().parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "lib"))
import attic_common as common  # noqa: E402
from attic_common import NAME, secure_path  # noqa: E402

RESERVED = {"list", "status", "boot", "setup", "update"}
GIT = "/usr/bin/git"
ERRORS = (ValueError, OSError, subprocess.SubprocessError)
BOOT_TIMEOUT = 60


def discover() -> list[str]:
    """Discover modules by directory name without executing their code."""
    return sorted(path.parent.name for path in (ROOT / "tweaks").glob("*/tweak.py")
                  if NAME.fullmatch(path.parent.name) and path.parent.name not in RESERVED)


def tweak_path(name: str) -> Path:
    """Resolve only discovered scripts, checking permissions before root execution."""
    if not NAME.fullmatch(name) or name not in discover():
        raise ValueError(f"Unknown tweak: {name}")
    path = ROOT / "tweaks" / name / "tweak.py"
    if os.geteuid() == 0:
        secure_path(ROOT / "lib/attic_common.py")
        secure_path(path)
    return path


def exit_code(result: subprocess.CompletedProcess) -> int:
    """Report a child killed by a signal the way a shell does."""
    return result.returncode if result.returncode >= 0 else 128 - result.returncode


def run_tweak(name: str, arguments: list[str], timeout: int | None = None) -> int:
    """Forward argv and terminal streams without a shell or module import."""
    return exit_code(subprocess.run([sys.executable, "-B", str(tweak_path(name)), *arguments],
                                    timeout=timeout))


def read_enabled() -> list[str]:
    return common.read_enabled(ROOT)


def write_enabled(names: list[str]) -> None:
    """Atomically persist activation; caller holds the management lock.

    The list holds no secrets and stays readable so status works without root.
    """
    data = json.dumps(sorted(names), indent=2) + "\n"
    common.atomic_write(ROOT / "local/enabled.json", data.encode(), 0o644)


@contextlib.contextmanager
def management_lock():
    """Serialize mutations and require a protected persistent checkout."""
    if sys.platform != "linux" or os.geteuid() != 0:
        raise ValueError("Run management commands as root on the NAS")
    if not str(ROOT).startswith("/mnt/"):
        raise ValueError("Use a persistent checkout under /mnt")
    secure_path(ROOT / "attic")
    secure_path(ROOT / "lib/attic_common.py")
    directory = ROOT / "local"
    if directory.exists() or directory.is_symlink():
        secure_path(directory)
    else:
        directory.mkdir(mode=0o755)
    path = directory / "manage.lock"
    if path.exists() or path.is_symlink():
        secure_path(path)
    with path.open("a") as stream:
        os.chmod(path, 0o600)
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield


def boot(names: list[str]) -> int:
    """Restore only explicitly enabled tweaks; one failure or hang does not skip the rest."""
    failed = False
    for name in names:
        try:
            code = run_tweak(name, ["boot"], timeout=BOOT_TIMEOUT)
            if code:
                print(f"{name}: boot failed (exit {code})", file=sys.stderr)
                failed = True
        except ERRORS as error:
            print(f"{name}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


def manage(name: str, arguments: list[str]) -> int:
    with management_lock():
        names = read_enabled()
        tweak_path(name)
        action = arguments[0]
        if action == "uninstall":
            # Disable first so failed cleanup cannot re-enable it next boot.
            write_enabled([item for item in names if item != name])
        code = run_tweak(name, arguments)
        if action == "install" and code == 0:
            try:
                write_enabled(sorted(set(names) | {name}))
            except OSError as error:
                raise ValueError(
                    f"{name}: runtime installed, but activation could not be saved; "
                    "fix local state storage and repeat install"
                ) from error
        return code


def forget(name: str) -> int:
    """Drop a tweak whose folder left the checkout; its code cannot run any cleanup."""
    with management_lock():
        names = read_enabled()
        if name not in names:
            raise ValueError(f"Unknown tweak: {name}")
        write_enabled([item for item in names if item != name])
    print(f"{name}: removed from the boot list; its code is gone, so reboot to clear runtime files")
    return 0


def update() -> int:
    """Pull the checkout, then let the new code re-run setup and boot."""
    if sys.platform != "linux" or os.geteuid() != 0:
        raise ValueError("Run management commands as root on the NAS")
    # Setup and boot take the management lock themselves, so it is not held here.
    for command in ([GIT, "-C", str(ROOT), "pull", "--ff-only"],
                    [sys.executable, "-B", str(ROOT / "attic"), "setup", "install"],
                    [sys.executable, "-B", str(ROOT / "attic"), "boot"]):
        code = exit_code(subprocess.run(command))
        if code:
            print(f"attic: update stopped: {' '.join(command[-2:])} failed (exit {code})", file=sys.stderr)
            return code
    return 0


def all_status() -> int:
    enabled = read_enabled()
    failed = False
    for name in sorted(set(discover()) | set(enabled)):
        activation = "enabled" if name in enabled else "disabled"
        print(f"{name}: {activation}", flush=True)
        try:
            if run_tweak(name, ["status"]):
                failed = True
        except ERRORS as error:
            print(f"{name}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        usage="%(prog)s {list,status,boot,setup,update} | TWEAK [COMMAND [ARGS...]]")
    parser.add_argument("target", help="list, status, boot, setup, update, or a tweak name")
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.target == "setup":
        # Bootstrap intentionally runs before ownership repair and management locking.
        # The trusted checkout is selected by the administrator running this command.
        return exit_code(subprocess.run([sys.executable, "-B", str(ROOT / "lib/attic_setup.py"),
                                         *args.arguments]))
    if args.target in RESERVED:
        if args.arguments:
            parser.error(f"{args.target} takes no arguments; use TWEAK COMMAND for tweak commands")
        if args.target == "list":
            for name in discover():
                print(name)
            return 0
        if args.target == "status":
            return all_status()
        if args.target == "update":
            return update()
        with management_lock():
            return boot(read_enabled())
    if args.arguments == ["uninstall"] and args.target not in discover():
        return forget(args.target)
    tweak_path(args.target)
    # Help must never change activation, including `install --help`.
    if (not args.arguments or any(arg in ("-h", "--help") for arg in args.arguments)
            or args.arguments[0] == "status"):
        return run_tweak(args.target, args.arguments)
    return manage(args.target, args.arguments)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ERRORS as error:
        print(f"attic: {error}", file=sys.stderr)
        sys.exit(1)
